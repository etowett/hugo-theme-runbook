{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'exec python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/guardrails.py\"'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
